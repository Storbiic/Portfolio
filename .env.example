# SMTP Configuration - MailerSend
# Sign up at https://www.mailersend.com
# Get credentials from: Domains → your domain → SMTP

SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=your-mailersend-smtp-username
SMTP_PASS=your-mailersend-smtp-password

# Recipient Email (where contact form submissions will be sent)
RECIPIENT_EMAIL=saadnajar@icloud.com

# Server Port
PORT=3001

# Frontend Environment Variables (for Vite)
# In production, set this to your deployed backend URL
VITE_API_URL=http://localhost:3001
